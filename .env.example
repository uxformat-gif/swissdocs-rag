# Copy to .env. Nothing here is a secret. Do not commit a real API key.

# Qdrant. Leave QDRANT_PATH empty to use the server URL.
# Set QDRANT_PATH=data/qdrant for a local embedded database (single process).
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
QDRANT_COLLECTION=swissdocs

CORPUS_PATH=data/sample/chunks.jsonl
# Optional private JSONL (insurer GTCs you are allowed to process). Not fetched by this repo.
CUSTOM_CORPUS_PATH=

# Local ONNX embeddings. multilingual-e5-large is about 2.2 GB on first use.
# A smaller alternative: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_BACKEND=fastembed

# ollama | openai | extractive
# extractive quotes the retrieved articles and needs no generative model.
# The library default is ollama so questions and passages stay on the machine (nLPD).
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_FALLBACK_EXTRACTIVE=true

# Optional OpenAI-compatible endpoint. Leave the key empty unless you opt in.
# Using this sends the question and the retrieved passages to that provider.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TOP_K=5
RETRIEVE_K=20
RRF_K=60
# Calibrated on the committed eval set. See README. Set to 0 to disable the gate.
MIN_DENSE_SCORE=0.78

HOST=0.0.0.0
PORT=8000
